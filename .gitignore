.DS_Store

# compiled Python bytecode — never track; regenerated on every run, which
# otherwise breaks `git diff --exit-code` in the validate-skills check.
__pycache__/
*.pyc

# raw local Claude Code session logs (timestamped root .txt dumps) — never track (PII: home paths)
**/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*.txt

# test/coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/
